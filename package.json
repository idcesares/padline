{
  "name": "padline",
  "private": true,
  "version": "0.1.0",
  "description": "URL-first, no-account, real-time collaborative pads. A modern Dontpad successor.",
  "author": {
    "name": "Isaac D'Césares",
    "email": "contact@padline.page",
    "url": "https://github.com/idcesares"
  },
  "license": "MIT",
  "homepage": "https://padline.page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcesares/padline.git"
  },
  "bugs": "https://github.com/idcesares/padline/issues",
  "keywords": [
    "collaborative-editing",
    "yjs",
    "crdt",
    "cloudflare-workers",
    "durable-objects",
    "blocknote",
    "dontpad",
    "notepad",
    "real-time"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "tsc -p test/tsconfig.json --noEmit && vitest run --max-workers=1 --no-isolate",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/padline/wrangler.json",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/shadcn": "^0.55.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "partyserver": "^0.5.10",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "sharp@0.35.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
