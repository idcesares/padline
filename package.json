{
  "name": "padline",
  "private": true,
  "version": "0.1.0",
  "description": "A public, no-account, real-time notepad. Open an address, type, everyone on it sees it live.",
  "author": {
    "name": "Isaac D'Césares",
    "email": "contact@padline.page",
    "url": "https://github.com/idcesares"
  },
  "license": "MIT",
  "homepage": "https://padline.page",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idcesares/padline.git"
  },
  "bugs": "https://github.com/idcesares/padline/issues",
  "keywords": [
    "notepad",
    "collaborative-editing",
    "yjs",
    "crdt",
    "codemirror",
    "cloudflare-workers",
    "durable-objects",
    "dontpad",
    "real-time"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "test": "tsc -p test/tsconfig.json --noEmit && vitest run --max-workers=1 --no-isolate",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/padline/wrangler.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply padline --local"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "partyserver": "^0.5.10",
    "qrcode-generator": "^2.0.4",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "sharp@0.35.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
