{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "padline.page",
      "custom_domain": true
    },
    {
      "pattern": "www.padline.page",
      "custom_domain": true
    },
    {
      "pattern": "padline.dcesares.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    // "none", not "single-page-application". This is the setting that keeps a
    // missing hashed chunk from being answered with index.html at 200 — which
    // public/_headers would then stamp immutable for a year, leaving clients
    // caching HTML as JavaScript after a deploy (ADR-0004). Page routes get no
    // implicit shell either, so worker/index.ts serves it explicitly. Do not
    // change this.
    "not_found_handling": "none",
    "binding": "ASSETS",
    // Worker-first for everything except hashed assets: /api, /parties
    // websockets, crawler OG, admin ops, and the canonical-host redirect all
    // live in the Worker. /assets/* is excluded so the edge serves it free and
    // unlimited. Worker-first would make every chunk a billable invocation
    // (~10x on a cold pad load) and, on the free tier, 429 the entire bundle
    // once the quota is spent rather than degrading — assets keep serving
    // through a negative pattern. The accepted cost: a negative pattern never
    // invokes the Worker, not even on a miss, so a missing chunk gets the
    // asset router's bare 404 and inherits the immutable /assets/* rule from
    // public/_headers. A cached empty 404 is survivable; cached HTML was not.
    // See ADR-0004.
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PadRoom",
        "class_name": "PadRoom"
      }
    ]
  },
  // The pad index, reports and the action log (ADR-0002). The id below is the
  // padline.page database; a self-hosted instance creates its own, replaces the
  // id and applies the migrations before the first deploy. See docs/self-hosting.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padline",
      "database_id": "2aaade6c-6a66-4f89-ad39-4837c3c18b5e",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access settings for /admin and /api/admin/* (ADR-0002). Both
  // empty means the admin surface answers 403 to everyone. Neither is a secret.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "idcesares.cloudflareaccess.com",
    "ACCESS_AUD": "4e315e1bafe3dddffed8f37d28c657b7766d4b74942c2c2973fe1479c23c1b7a"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PadRoom"]
    },
    {
      // Applied migration: its class stays exported as a placeholder
      // (worker/moderation-ledger.ts) until a deleted_classes migration
      // removes it.
      "tag": "v2",
      "new_sqlite_classes": ["ModerationLedger"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
